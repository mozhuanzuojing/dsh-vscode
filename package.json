{
  "name": "dsh-vscode",
  "displayName": "DSH Client",
  "description": "在 VSCode 辅助侧边栏内嵌 100% 原版 DeepSeek Harness (DSH) Web 界面；点击对话/轨迹里的文件路径直接在 VSCode 编辑器打开。",
  "version": "0.5.9",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mozhuanzuojing/dsh-vscode.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "sidebar",
    "proxy",
    "webview"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dsh.openSidebar",
        "title": "Open DSH Sidebar",
        "category": "DSH"
      },
      {
        "command": "dsh.refresh",
        "title": "DSH: 刷新界面",
        "category": "DSH"
      },
      {
        "command": "dsh.diagnostics",
        "title": "DSH: 诊断",
        "category": "DSH"
      },
      {
        "command": "dsh.openInBrowser",
        "title": "DSH: 在浏览器打开原版界面",
        "category": "DSH"
      },
      {
        "command": "awakening.openSettings",
        "title": "Awakening: 打开设置",
        "category": "Awakening"
      },
      {
        "command": "awakening.configureHarnessUrl",
        "title": "Awakening: 配置 harness 地址",
        "category": "Awakening"
      },
      {
        "command": "awakening.explainSelection",
        "title": "用 DSH 解释选中内容",
        "category": "Awakening"
      },
      {
        "command": "awakening.fixSelection",
        "title": "用 DSH 修复选中内容",
        "category": "Awakening"
      },
      {
        "command": "awakening.refactorSelection",
        "title": "用 DSH 重构选中内容",
        "category": "Awakening"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dsh.openSidebar",
          "group": "navigation",
          "icon": "media/icon.svg"
        },
        {
          "command": "awakening.configureHarnessUrl",
          "group": "navigation",
          "icon": "$(settings-gear)"
        }
      ],
      "editor/context": [
        {
          "command": "awakening.explainSelection",
          "group": "1_dsh",
          "when": "editorHasSelection"
        },
        {
          "command": "awakening.fixSelection",
          "group": "1_dsh",
          "when": "editorHasSelection"
        },
        {
          "command": "awakening.refactorSelection",
          "group": "1_dsh",
          "when": "editorHasSelection"
        }
      ],
      "commandPalette": [
        {
          "command": "awakening.configureHarnessUrl",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "DSH",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "type": "webview",
          "id": "dsh.chatView",
          "name": "DSH Awakening"
        }
      ]
    },
    "configuration": {
      "title": "Awakening DSH",
      "properties": {
        "awakening.dsh.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3080",
          "description": "DSH harness Web 服务地址（默认 3080，自动检测真实监听端口）。显式修改后优先使用，不做自动检测。修改后自动重启本地代理并刷新界面。"
        },
        "awakening.dsh.interceptPickDirectory": {
          "type": "boolean",
          "default": true,
          "description": "拦截 host.pickDirectory 并在 VSCode 里弹原生目录选择器（Cursor 同款体验）。关闭后原样转发给 harness，由 harness 宿主弹它自己的对话框——跨机拓扑（VSCode 与 harness 不共享文件系统）的降级路径。修改后自动重启本地代理。"
        },
        "awakening.dsh.probeRange": {
          "type": "array",
          "default": [
            3080,
            3099
          ],
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "自动检测端口时扫描的 TCP 端口范围 [起始, 终止]（含两端）。修改后自动重启本地代理。"
        },
        "awakening.dsh.autoMoveToSecondarySidebar": {
          "type": "boolean",
          "default": true,
          "description": "扩展激活时是否自动将 DSH 视图移入辅助侧边栏（secondary sidebar）。关闭后视图在主侧边栏；可手动拖拽切换。修改后需重载窗口生效。"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "probe": "npm run build && node dist/scripts/probe.js",
    "smoke": "npm run build && node dist/scripts/proxy-smoke.js",
    "test": "npm run build && node dist/scripts/test-units.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.120.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
